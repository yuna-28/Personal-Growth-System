{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grandol",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8767",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8767
    },
    {
      "name": "grandol-local-fake",
